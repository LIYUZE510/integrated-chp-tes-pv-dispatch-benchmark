# Python caches and compiled files
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.so

# Packaging
*.egg-info/
.eggs/
build/
dist/
*.whl
*.tar.gz

# Test and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
junit/

# Virtual environments
.venv/
venv/
env/
.python-version

# Jupyter
.ipynb_checkpoints/

# OS / editors
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Local runtime outputs
logs/*
outputs/*
!logs/.gitkeep
!outputs/.gitkeep

# External downloads and caches
# Released benchmark inputs and frozen paper artifacts remain version controlled.
data/external/*
!data/external/.gitkeep
